{
  "name": "taskflow-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build for the TaskFlow frontend (no other JS build tooling required).",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --minify",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.10"
  }
}
